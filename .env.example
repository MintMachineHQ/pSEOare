# Every value here is optional. A missing key is skipped, never fatal.
# Enrichment tries these in order and falls back to copy derived from the page's own
# numbers, so the corpus is never thin and a failed enrichment never fails a build.

# Free-tier AI providers, in the order engine/config.json -> gemini.providers uses them.
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
# Legacy comma-separated pool, kept for older configs; not the plan any more.
GEMINI_API_KEYS=

# Search-engine notification.
INDEXNOW_KEY=
# Intentionally left empty. Google restricts the Indexing API to job and broadcast
# pages, so submitting ordinary content through it risks a manual action.
GOOGLE_INDEXING_CREDENTIALS=

# Bing Webmaster Tools API key. The daily build spends Bing's 100 URL/day allowance
# on the long-tail pages; without it that step is skipped and IndexNow still runs.
BING_WEBMASTER_KEY=

# Cloudflare Pages mirror (deploy-cloudflare.yml). CF_ACCOUNT_ID is optional: when it
# is empty the mirror lists accounts with the token and uses the first one.
CF_API_TOKEN=
CF_ACCOUNT_ID=
